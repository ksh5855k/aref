rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 사용자 정보 (users)
    // - 누구나 프로필(닉네임, 사진)은 볼 수 있어야 댓글창에서 보임
    // - 수정은 '본인'만 가능
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. 레퍼런스 본문 (references)
    // - 누구나 볼 수 있음 (비로그인 사용자도 구경 가능)
    // - 작성 및 삭제는 로그인한 사람만 가능
    // - 단, 비로그인 사용자도 글을 클릭했을 때 '조회수(views)'는 올라가야 하므로 조회수 증가만 예외적으로 허용
    match /references/{refId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // 3. 내 서랍 저장 데이터 (userSaves)
    // - 읽기(read)는 허용해서 홈 화면에서 '저장된 횟수'를 셀 수 있게 함
    // - 단, 생성/수정/삭제는 반드시 본인만 가능하게 철통 방어
    match /userSaves/{saveId} {
      allow read: if true;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 4. 내 서랍 폴더 (folders)
    // - 폴더 역시 '본인'만 관리 가능
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 5. 댓글 (comments)
    // - 누구나 볼 수 있음
    // - 작성은 로그인한 사람만, 삭제는 '댓글을 쓴 본인'만 가능
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}